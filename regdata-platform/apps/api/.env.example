# Backend port
PORT=3000

# Authentication mode: "mock" (development) or "sso" (not implemented yet).
# The mock mode refuses to start with NODE_ENV=production.
AUTH_MODE=mock

# Field rules upload (EMIR field-level validation rules)
# Labels of the two rule blocks in the RAG chunk (one per trade party), e.g. "PARTY_1,PARTY_2".
# Set them to the internal party prefixes in the bank's local .env.
FIELD_RULES_BLOCK_LABELS=LEG_1,LEG_2
# Prefix of party fields in the BNPP mapping column, without the party number
# (e.g. "AB" for AB1_/AB2_). Empty: any letters followed by 1_ or 2_.
# Set the real prefix only in the bank's local .env.
FIELD_RULES_PARTY_PREFIX=
# Four-eyes: the user who uploads cannot approve the fields of that upload.
FIELD_RULES_FOUR_EYES=true

# Query engine (DuckDB, ADR-005)
# Local JSON file with, per mart, the file path/glob and the mapping of logical to real column names.
# Path relative to apps/api or absolute. Copy query-bindings.example.json and fill it in locally (not in Git).
QUERY_BINDINGS_FILE=query-bindings.json
