# Porta do backend
PORT=3000

# Modo de autenticação: "mock" (desenvolvimento) ou "sso" (ainda não implementado).
# O modo mock recusa arrancar com NODE_ENV=production.
AUTH_MODE=mock

# Field rules upload (EMIR field-level validation rules)
# Labels of the two rule blocks in the RAG chunk: "LEG_1,LEG_2" (current spec) or "PARTE_1,PARTE_2".
FIELD_RULES_BLOCK_LABELS=LEG_1,LEG_2
# Four-eyes: the user who uploads cannot approve the fields of that upload.
FIELD_RULES_FOUR_EYES=true
